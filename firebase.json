{
  "firestore": {
    "database": "(default)",
    "location": "nam5",
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "hosting": {
    "site": "before-you-tape-2026",
    "public": "dist",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "regex": "^/$",
        "destination": "/index.html"
      },
      {
        "regex": "^/[jJ][uU][dD][gG][eE]/?$",
        "destination": "/index.html"
      },
      {
        "regex": "^/[rR][uU][lL][eE][sS]/?$",
        "destination": "/index.html"
      },
      {
        "regex": "^/[rR][aA][nN]/?$",
        "destination": "/index.html"
      },
      {
        "regex": "^/[aA][bB][oO][uU][tT]/?$",
        "destination": "/index.html"
      },
      {
        "regex": "^/[bB][lL][iI][nN][dD]/[^/]+/?$",
        "destination": "/index.html"
      }
    ]
  },
  "auth": {
    "providers": {
      "anonymous": true
    }
  }
}
