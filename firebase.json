{
  "firestore": {
    "database": "(default)",
    "location": "nam5",
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "hosting": {
    "site": "before-you-tape-2026",
    "public": "dist",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "/",
        "destination": "/index.html"
      },
      {
        "source": "/judge",
        "destination": "/index.html"
      },
      {
        "source": "/measured",
        "destination": "/index.html"
      },
      {
        "source": "/rules",
        "destination": "/index.html"
      },
      {
        "source": "/ran",
        "destination": "/index.html"
      },
      {
        "source": "/about",
        "destination": "/index.html"
      },
      {
        "source": "/worksheet",
        "destination": "/index.html"
      },
      {
        "source": "/blind/*",
        "destination": "/index.html"
      }
    ]
  },
  "auth": {
    "providers": {
      "anonymous": true
    }
  }
}
