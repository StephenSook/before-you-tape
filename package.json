{
  "name": "before-you-tape",
  "version": "0.1.0",
  "private": true,
  "description": "Hold each gift up to your laptop and see what the post office won't take, before you tape the box.",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:rules": "npx --yes firebase-tools@15.34.2 emulators:exec --only firestore --project demo-before-you-tape \"vitest run --config vitest.rules.config.ts\"",
    "tone": "tsx scripts/tone-check.ts",
    "guard": "tsx scripts/model-guard.ts",
    "hygiene": "tsx scripts/hygiene-guard.ts",
    "edition": "tsx scripts/build-edition.ts",
    "edition:check": "tsx scripts/build-edition.ts --check",
    "release:gate": "tsx scripts/release-gate.ts",
    "desk:apply": "tsx scripts/apply-desk-pass.ts",
    "appcheck:control": "tsx --env-file-if-exists=.env.local scripts/appcheck-control.ts",
    "device:e2e": "tsx scripts/device-e2e.ts"
  },
  "dependencies": {
    "firebase": "13.4.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router-dom": "7.18.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "10.0.1",
    "@firebase/rules-unit-testing": "6.0.0",
    "@playwright/test": "1.64.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "canvas": "3.2.3",
    "eslint": "10.14.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "fake-indexeddb": "6.2.7",
    "globals": "17.14.0",
    "jsdom": "29.1.1",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.5",
    "vitest": "5.1.0"
  }
}
