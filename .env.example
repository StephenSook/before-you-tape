# Copy to .env.local and fill in. Never commit real values.
# Firebase web app config (Firebase console > Project settings > Your apps).
VITE_FB_API_KEY=
VITE_FB_AUTH_DOMAIN=
VITE_FB_PROJECT_ID=
VITE_FB_APP_ID=
VITE_FB_MEASUREMENT_ID=
# reCAPTCHA Enterprise site key used by App Check.
VITE_RECAPTCHA_SITE_KEY=
# Set to true to use the local Firebase emulators.
VITE_USE_EMULATORS=false
