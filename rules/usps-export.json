[
  {
    "id": "USPS-INTL-FLAMMABLE-LIQUID",
    "layer": "usps_export",
    "scope": "item",
    "section": "Pub 52 623 (Class 3); IMM 136",
    "url": "https://pe.usps.com/text/pub52/pub52c6_006.htm",
    "basis": "summarized",
    "ourWording": "Flammable liquids can't go by international mail. That includes nail polish, hand sanitizer, and perfume or other liquids with alcohol.",
    "when": {
      "any": [
        { "all": [{ "fact": "tags", "op": "has", "value": "flammable" }, { "fact": "tags", "op": "has", "value": "liquid" }] },
        { "fact": "category", "op": "in", "value": ["nail_polish", "hand_sanitizer"] },
        { "fact": "tags", "op": "has", "value": "sanitizer" },
        {
          "all": [
            { "fact": "alcohol", "op": "eq", "value": "yes" },
            { "fact": "tags", "op": "has", "value": "liquid" },
            { "not": { "fact": "category", "op": "eq", "value": "lotion_cream" } }
          ]
        }
      ]
    },
    "outcome": "take_out"
  },
  {
    "id": "USPS-INTL-ALCOHOL-LOTION",
    "layer": "usps_export",
    "scope": "item",
    "section": "IMM 136.1; Pub 52 343.1",
    "url": "https://pe.usps.com/text/imm/immc1_015.htm",
    "basis": "inference",
    "ourWording": "Lotions and creams that list alcohol are often fine to mail, but USPS bars any liquid that can catch fire, and a label rarely says which. If the label says flammable, or alcohol is the first ingredient, take it out.",
    "when": {
      "all": [
        { "fact": "category", "op": "eq", "value": "lotion_cream" },
        { "fact": "alcohol", "op": "eq", "value": "yes" },
        { "not": { "fact": "tags", "op": "has", "value": "flammable" } },
        { "not": { "fact": "tags", "op": "has", "value": "sanitizer" } }
      ]
    },
    "outcome": "check"
  },
  {
    "id": "USPS-INTL-FLAMMABLE-OTHER",
    "layer": "usps_export",
    "scope": "item",
    "section": "Pub 52 623 (Classes 2 to 4)",
    "url": "https://pe.usps.com/text/pub52/pub52c6_006.htm",
    "basis": "summarized",
    "ourWording": "The label says it is flammable. Flammable goods can't go by international mail.",
    "when": {
      "all": [
        { "fact": "tags", "op": "has", "value": "flammable" },
        { "not": { "fact": "tags", "op": "has", "value": "liquid" } },
        { "not": { "fact": "category", "op": "in", "value": ["lighter_matches", "nail_polish", "hand_sanitizer"] } }
      ]
    },
    "outcome": "take_out"
  },
  {
    "id": "USPS-INTL-AEROSOL",
    "layer": "usps_export",
    "scope": "item",
    "section": "Pub 52 623 (Class 2); Packaging Instruction 2A",
    "url": "https://pe.usps.com/text/pub52/pub52c6_006.htm",
    "basis": "summarized",
    "ourWording": "Aerosols and other items under pressure can't go by international mail.",
    "when": { "fact": "tags", "op": "has", "value": "pressurized" },
    "outcome": "take_out"
  },
  {
    "id": "USPS-INTL-ALCOHOL-DRINK",
    "layer": "usps_export",
    "scope": "item",
    "section": "Pub 52 424",
    "url": "https://pe.usps.com/text/pub52/pub52c4_008.htm",
    "basis": "summarized",
    "ourWording": "Alcoholic drinks can't be mailed.",
    "when": { "fact": "tags", "op": "has", "value": "alcoholic_drink" },
    "outcome": "take_out"
  },
  {
    "id": "USPS-INTL-MATCHES-LIGHTERS",
    "layer": "usps_export",
    "scope": "item",
    "section": "Pub 52 623 (Class 4); Packaging Instruction 3C",
    "url": "https://pe.usps.com/text/pub52/pub52c6_006.htm",
    "basis": "summarized",
    "ourWording": "Matches and lighters can't go by international mail.",
    "when": { "any": [{ "fact": "tags", "op": "has", "value": "lighter" }, { "fact": "tags", "op": "has", "value": "matches" }] },
    "outcome": "take_out"
  },
  {
    "id": "USPS-INTL-EXPLOSIVE",
    "layer": "usps_export",
    "scope": "item",
    "section": "Pub 52 623 (Class 1)",
    "url": "https://pe.usps.com/text/pub52/pub52c6_006.htm",
    "basis": "summarized",
    "ourWording": "Fireworks, sparklers and other explosives can't go by international mail.",
    "when": { "fact": "tags", "op": "has", "value": "explosive" },
    "outcome": "take_out"
  },
  {
    "id": "USPS-INTL-CRACKER",
    "layer": "usps_export",
    "scope": "item",
    "section": "Pub 52 623 (Class 1)",
    "url": "https://pe.usps.com/text/pub52/pub52c6_006.htm",
    "basis": "inference",
    "ourWording": "Christmas crackers hold a small snap charge, and explosives can't go by international mail. Check before you pack them.",
    "when": { "fact": "tags", "op": "has", "value": "christmas_cracker" },
    "outcome": "check"
  },
  {
    "id": "USPS-INTL-ENDS",
    "layer": "usps_export",
    "scope": "item",
    "section": "IMM 136.4",
    "url": "https://pe.usps.com/text/imm/immc1_015.htm",
    "basis": "summarized",
    "ourWording": "E-cigarettes, vapes and e-liquids can't go by international mail.",
    "when": { "fact": "tags", "op": "has", "value": "vaping" },
    "outcome": "take_out"
  },
  {
    "id": "USPS-INTL-TOBACCO",
    "layer": "usps_export",
    "scope": "item",
    "section": "IMM 136.4",
    "url": "https://pe.usps.com/text/imm/immc1_015.htm",
    "basis": "summarized",
    "ourWording": "Cigarettes and other tobacco can't go by international mail.",
    "when": { "fact": "tags", "op": "has", "value": "tobacco" },
    "outcome": "take_out"
  },
  {
    "id": "USPS-INTL-CIGAR",
    "layer": "usps_export",
    "scope": "item",
    "section": "USPS international shipping restrictions",
    "url": "https://www.usps.com/international/shipping-restrictions.htm",
    "basis": "summarized",
    "ourWording": "Cigars can go only to countries that accept them. Check that the country allows them.",
    "when": { "fact": "tags", "op": "has", "value": "cigar" },
    "outcome": "check"
  },
  {
    "id": "USPS-INTL-MERCURY",
    "layer": "usps_export",
    "scope": "item",
    "section": "USPS international shipping restrictions",
    "url": "https://www.usps.com/international/shipping-restrictions.htm",
    "basis": "summarized",
    "ourWording": "Anything with mercury, such as an old thermometer or a CFL bulb, can't go by international mail.",
    "when": { "fact": "tags", "op": "has", "value": "mercury" },
    "outcome": "take_out"
  },
  {
    "id": "USPS-INTL-HEMP",
    "layer": "usps_export",
    "scope": "item",
    "section": "USPS international shipping restrictions",
    "url": "https://www.usps.com/international/shipping-restrictions.htm",
    "basis": "summarized",
    "ourWording": "Hemp and CBD products can't go by international mail.",
    "when": { "fact": "tags", "op": "has", "value": "hemp" },
    "outcome": "take_out"
  },
  {
    "id": "USPS-INTL-HEMP-MAYBE",
    "layer": "usps_export",
    "scope": "item",
    "section": "USPS international shipping restrictions",
    "url": "https://www.usps.com/international/shipping-restrictions.htm",
    "basis": "inference",
    "ourWording": "The label lists hemp. Hemp-based products can't go by international mail, so check whether this is one.",
    "when": {
      "all": [
        { "fact": "tags", "op": "has", "value": "hemp_maybe" },
        { "not": { "fact": "tags", "op": "has", "value": "hemp" } }
      ]
    },
    "outcome": "check"
  },
  {
    "id": "USPS-INTL-DRY-ICE",
    "layer": "usps_export",
    "scope": "item",
    "section": "Pub 52 623; IMM 136",
    "url": "https://pe.usps.com/text/pub52/pub52c6_006.htm",
    "basis": "summarized",
    "ourWording": "Dry ice can't go by international mail.",
    "when": { "fact": "tags", "op": "has", "value": "dry_ice" },
    "outcome": "take_out"
  },
  {
    "id": "USPS-INTL-MAGNET",
    "layer": "usps_export",
    "scope": "item",
    "section": "Pub 52 349.4; IMM 136",
    "url": "https://pe.usps.com/text/pub52/pub52c3_028.htm",
    "basis": "summarized",
    "ourWording": "Only very weak magnets can go by international mail. Check how strong this one is.",
    "when": { "fact": "tags", "op": "has", "value": "magnet" },
    "outcome": "check"
  },
  {
    "id": "USPS-INTL-GLUE-PAINT",
    "layer": "usps_export",
    "scope": "item",
    "section": "USPS international shipping restrictions",
    "url": "https://www.usps.com/international/shipping-restrictions.htm",
    "basis": "summarized",
    "ourWording": "Most glues and many paints are flammable and can't go. Check the label for a flammable warning.",
    "when": { "fact": "category", "op": "eq", "value": "glue_paint" },
    "outcome": "check"
  },
  {
    "id": "USPS-INTL-LI-LOOSE",
    "layer": "usps_export",
    "scope": "item",
    "section": "Pub 52 622.5",
    "url": "https://pe.usps.com/text/pub52/pub52c6_005.htm",
    "basis": "inference",
    "ourWording": "Lithium batteries must be inside the device they power. Spare batteries, batteries packed beside a device and power banks can't go.",
    "when": {
      "all": [
        { "fact": "battery.presence", "op": "in", "value": ["loose", "packed_beside"] },
        { "not": { "fact": "battery.chemistry", "op": "eq", "value": "not_lithium" } }
      ]
    },
    "outcome": "take_out"
  },
  {
    "id": "USPS-INTL-LOOSE-NON-LITHIUM",
    "layer": "usps_export",
    "scope": "item",
    "section": "Pub 52 348 and IMM 135.6 (international mail not confirmed)",
    "url": "https://pe.usps.com/text/pub52/pub52c3_027.htm",
    "basis": "estimate",
    "ourWording": "We could not confirm that loose AA, AAA or other non-lithium batteries can go by international mail, so take them out of the box.",
    "when": {
      "all": [
        { "fact": "battery.presence", "op": "in", "value": ["loose", "packed_beside"] },
        { "fact": "battery.chemistry", "op": "eq", "value": "not_lithium" }
      ]
    },
    "outcome": "take_out"
  },
  {
    "id": "USPS-INTL-LI-USED-DEVICE",
    "layer": "usps_export",
    "scope": "item",
    "section": "Pub 52 622.5; 623",
    "url": "https://pe.usps.com/text/pub52/pub52c6_005.htm",
    "basis": "summarized",
    "ourWording": "Used devices with lithium batteries can't go by international mail. Only new or maker-refurbished ones can.",
    "when": {
      "all": [
        { "fact": "battery.presence", "op": "eq", "value": "installed" },
        { "fact": "condition", "op": "eq", "value": "used" }
      ]
    },
    "outcome": "take_out"
  },
  {
    "id": "USPS-INTL-LI-NEW-OPENED",
    "layer": "usps_export",
    "scope": "item",
    "section": "Pub 52 622.5; 349.2",
    "url": "https://pe.usps.com/text/pub52/pub52c6_005.htm",
    "basis": "inference",
    "ourWording": "New devices are allowed in their original packaging. Pack this one back in its own box.",
    "when": {
      "all": [
        { "fact": "battery.presence", "op": "eq", "value": "installed" },
        { "fact": "condition", "op": "eq", "value": "new_opened" }
      ]
    },
    "outcome": "check"
  },
  {
    "id": "USPS-INTL-LI-NO-WH",
    "layer": "usps_export",
    "scope": "item",
    "section": "Pub 52 622.52",
    "url": "https://pe.usps.com/text/pub52/pub52c6_005.htm",
    "basis": "summarized",
    "ourWording": "We can't see the battery rating through the box. Type the Wh from the box or the maker's page.",
    "when": {
      "all": [
        { "fact": "battery.presence", "op": "eq", "value": "installed" },
        { "not": { "fact": "battery.chemistry", "op": "eq", "value": "li_metal" } },
        { "fact": "battery.whStatus", "op": "in", "value": ["none", "computed_only"] }
      ]
    },
    "outcome": "check"
  },
  {
    "id": "USPS-INTL-LI-WH-MISMATCH",
    "layer": "usps_export",
    "scope": "item",
    "section": "Pub 52 622.52",
    "url": "https://pe.usps.com/text/pub52/pub52c6_005.htm",
    "basis": "summarized",
    "ourWording": "The battery numbers we read don't agree with each other. Check the label and type the numbers.",
    "when": {
      "all": [
        { "fact": "battery.presence", "op": "eq", "value": "installed" },
        { "fact": "battery.whStatus", "op": "in", "value": ["printed_mismatch", "implausible"] }
      ]
    },
    "outcome": "check"
  },
  {
    "id": "USPS-INTL-LI-CELL-OVER",
    "layer": "usps_export",
    "scope": "item",
    "section": "Pub 52 622.52",
    "url": "https://pe.usps.com/text/pub52/pub52c6_005.htm",
    "basis": "summarized",
    "ourWording": "A lithium-ion cell above 20 Wh can't go by international mail.",
    "when": {
      "all": [
        { "fact": "battery.presence", "op": "eq", "value": "installed" },
        { "fact": "battery.countAs", "op": "eq", "value": "cell" },
        { "fact": "battery.wh", "op": "gt", "value": 20 }
      ]
    },
    "outcome": "take_out"
  },
  {
    "id": "USPS-INTL-LI-BATTERY-OVER",
    "layer": "usps_export",
    "scope": "item",
    "section": "Pub 52 622.52",
    "url": "https://pe.usps.com/text/pub52/pub52c6_005.htm",
    "basis": "summarized",
    "ourWording": "A lithium-ion battery above 100 Wh can't go by international mail.",
    "when": {
      "all": [
        { "fact": "battery.presence", "op": "eq", "value": "installed" },
        { "fact": "battery.wh", "op": "gt", "value": 100 }
      ]
    },
    "outcome": "take_out"
  },
  {
    "id": "USPS-INTL-LI-METAL-UNKNOWN",
    "layer": "usps_export",
    "scope": "item",
    "section": "Pub 52 622.51",
    "url": "https://pe.usps.com/text/pub52/pub52c6_005.htm",
    "basis": "summarized",
    "ourWording": "This has a lithium metal cell, such as a coin cell. We can't confirm how much lithium it holds, so check the maker's page.",
    "when": {
      "all": [
        { "fact": "battery.presence", "op": "eq", "value": "installed" },
        { "fact": "battery.chemistry", "op": "eq", "value": "li_metal" },
        { "not": { "fact": "battery.lithiumGrams", "op": "gt", "value": 0 } }
      ]
    },
    "outcome": "check"
  },
  {
    "id": "USPS-INTL-LI-METAL-CELL-OVER",
    "layer": "usps_export",
    "scope": "item",
    "section": "Pub 52 622.51",
    "url": "https://pe.usps.com/text/pub52/pub52c6_005.htm",
    "basis": "summarized",
    "ourWording": "A lithium metal cell with more than 1 g of lithium can't go by international mail.",
    "when": {
      "all": [
        { "fact": "battery.presence", "op": "eq", "value": "installed" },
        { "fact": "battery.countAs", "op": "eq", "value": "cell" },
        { "fact": "battery.lithiumGrams", "op": "gt", "value": 1 }
      ]
    },
    "outcome": "take_out"
  },
  {
    "id": "USPS-INTL-LI-METAL-BATTERY-OVER",
    "layer": "usps_export",
    "scope": "item",
    "section": "Pub 52 622.51",
    "url": "https://pe.usps.com/text/pub52/pub52c6_005.htm",
    "basis": "summarized",
    "ourWording": "A lithium metal battery with more than 2 g of lithium can't go by international mail.",
    "when": {
      "all": [
        { "fact": "battery.presence", "op": "eq", "value": "installed" },
        { "fact": "battery.lithiumGrams", "op": "gt", "value": 2 }
      ]
    },
    "outcome": "take_out"
  },
  {
    "id": "USPS-INTL-LI-METAL-CLASS",
    "layer": "usps_export",
    "scope": "item",
    "section": "Pub 52 622.51",
    "url": "https://pe.usps.com/text/pub52/pub52c6_005.htm",
    "basis": "summarized",
    "ourWording": "Between 1 g and 2 g of lithium is allowed for a battery but not for a single cell. Say whether it has one cell or more.",
    "when": {
      "all": [
        { "fact": "battery.presence", "op": "eq", "value": "installed" },
        { "fact": "battery.countAs", "op": "eq", "value": "unknown" },
        { "fact": "battery.lithiumGrams", "op": "gt", "value": 1 },
        { "fact": "battery.lithiumGrams", "op": "lte", "value": 2 }
      ]
    },
    "outcome": "check",
    "askId": "cell_count"
  },
  {
    "id": "USPS-INTL-LI-BOX-COUNT",
    "layer": "usps_export",
    "scope": "box",
    "section": "Pub 52 622.5",
    "url": "https://pe.usps.com/text/pub52/pub52c6_005.htm",
    "basis": "summarized",
    "ourWording": "Too many lithium batteries for one box. A box can hold 4 cells or 2 batteries, not both.",
    "when": { "fact": "battery.presence", "op": "eq", "value": "installed" },
    "outcome": "take_out"
  },
  {
    "id": "USPS-INTL-LI-BOX-MIXED",
    "layer": "usps_export",
    "scope": "box",
    "section": "Pub 52 622.5",
    "url": "https://pe.usps.com/text/pub52/pub52c6_005.htm",
    "basis": "summarized",
    "ourWording": "A box can hold 4 cells or 2 batteries, not both. This box may have both.",
    "when": { "fact": "battery.presence", "op": "eq", "value": "installed" },
    "outcome": "check"
  },
  {
    "id": "USPS-INTL-LI-NO-MARKING",
    "layer": "usps_export",
    "scope": "note",
    "section": "Pub 52 622.5",
    "url": "https://pe.usps.com/text/pub52/pub52c6_005.htm",
    "basis": "summarized",
    "ourWording": "Don't put lithium battery marks or labels on the outside of the box.",
    "when": { "fact": "battery.presence", "op": "eq", "value": "installed" },
    "outcome": "note"
  },
  {
    "id": "USPS-INTL-LI-TWO-BOXES",
    "layer": "usps_export",
    "scope": "note",
    "section": "Pub 52 622.5; 349.2",
    "url": "https://pe.usps.com/text/pub52/pub52c6_005.htm",
    "basis": "summarized",
    "ourWording": "No more than 2 boxes with lithium batteries can go to one address in one mailing.",
    "when": { "fact": "battery.presence", "op": "eq", "value": "installed" },
    "outcome": "note"
  },
  {
    "id": "DATA-NEEDS-ANSWER",
    "layer": "data",
    "scope": "item",
    "section": "Before You Tape: questions",
    "url": "https://before-you-tape-2026.web.app/rules",
    "basis": "inference",
    "ourWording": "Does the label list alcohol? Answer to finish this check.",
    "when": {
      "all": [
        { "fact": "alcohol", "op": "eq", "value": "unknown" },
        { "not": { "fact": "tags", "op": "has", "value": "alcohol_free_unsure" } },
        {
          "any": [
            { "fact": "category", "op": "in", "value": ["perfume_fragrance", "liquid_toiletry", "medicine"] },
            { "fact": "tags", "op": "has", "value": "fragrance" },
            { "fact": "tags", "op": "has", "value": "alcohol_flag" }
          ]
        }
      ]
    },
    "outcome": "check",
    "askId": "label_alcohol"
  },
  {
    "id": "DATA-NEEDS-ANSWER",
    "layer": "data",
    "scope": "item",
    "section": "Before You Tape: questions",
    "url": "https://before-you-tape-2026.web.app/rules",
    "basis": "inference",
    "ourWording": "We read \"alcohol\" at the end of one line and \"free\" at the start of the next. Does the label say alcohol-free? Answer to finish this check.",
    "when": {
      "all": [
        { "fact": "alcohol", "op": "eq", "value": "unknown" },
        { "fact": "tags", "op": "has", "value": "alcohol_free_unsure" }
      ]
    },
    "outcome": "check",
    "askId": "label_alcohol_free"
  },
  {
    "id": "DATA-NEEDS-ANSWER",
    "layer": "data",
    "scope": "item",
    "section": "Before You Tape: questions",
    "url": "https://before-you-tape-2026.web.app/rules",
    "basis": "inference",
    "ourWording": "Is it new? Answer to finish this check.",
    "when": {
      "all": [
        { "fact": "battery.presence", "op": "eq", "value": "installed" },
        { "fact": "condition", "op": "eq", "value": "unknown" }
      ]
    },
    "outcome": "check",
    "askId": "device_condition"
  },
  {
    "id": "DATA-NEEDS-ANSWER",
    "layer": "data",
    "scope": "item",
    "section": "Before You Tape: questions",
    "url": "https://before-you-tape-2026.web.app/rules",
    "basis": "inference",
    "ourWording": "Where is the battery? Answer to finish this check.",
    "when": { "fact": "battery.presence", "op": "eq", "value": "unknown" },
    "outcome": "check",
    "askId": "battery_installed"
  }
]
